{
  "name": "@aituber-onair/example-codex-workspace-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "fmt": "biome format . --write",
    "fmt:check": "biome format .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@aituber-onair/agent": "file:../.."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.8.3",
    "vitest": "^1.3.1"
  }
}
