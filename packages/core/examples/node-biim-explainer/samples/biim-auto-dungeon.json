    {
      "id": "auto-4",
      "speaker": "dango",
      "text": "なんだか嫌な予感がする…",
      "at": "@auto-3:end+6.600",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-5",
      "speaker": "dango",
      "text": "あー！今のは悔しい！",
      "at": "@auto-4:end+1.600",
      "pauseAfter": 0.3
