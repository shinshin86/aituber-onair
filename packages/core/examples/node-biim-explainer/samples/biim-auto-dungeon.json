{
  "$schema": "../schema/biim-script.schema.json",
  "canvas": "16:9",
  "fps": 30,
  "seed": 1,
  "speakers": {
    "dango": {
      "name": "だんご",
      "image": "../assets/yukkuri/dango",
      "mirror": true,
      "voice": {
        "engine": "sine",
        "options": {
          "secondsPerChar": 0.2,
          "frequency": 440
        }
      }
    }
  },
  "defaults": {
    "pauseAfter": 0.3
  },
  "lines": [
    {
      "id": "auto-1",
      "speaker": "dango",
      "text": "さあ、出発！知らない場所を歩く時の、\nこのわくわくする感じが好きなんだよね。",
      "at": 0,
      "pauseAfter": 0.3
    },
    {
      "id": "auto-2",
      "speaker": "dango",
      "text": "この先が気になるなあ。焦らず見ていこう！",
      "at": "@auto-1:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-3",
      "speaker": "dango",
      "text": "あれ、そっちへ行くんだ！つい寄り道したくなるのに。",
      "at": "@auto-2:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-4",
      "speaker": "dango",
      "text": "おっ、見えてきた！そのまま近づいて大丈夫かな？",
      "at": "@auto-3:end+1.000",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-5",
      "speaker": "dango",
      "text": "よし、いい感じ！この調子で先へ進みたいね。",
      "at": "@auto-4:end+1.400",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-6",
      "speaker": "dango",
      "text": "なんだか嫌な予感…。大丈夫かな？",
      "at": "@auto-5:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-7",
      "speaker": "dango",
      "text": "あー！今のは悔しい！でも、まだ諦めたくないよね。",
      "at": "@auto-6:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-8",
      "speaker": "dango",
      "text": "今度こそ、落ち着いていこう。応援してるよ！",
      "at": "@auto-7:end+1.200",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-9",
      "speaker": "dango",
      "text": "ここ、さっきより慎重だね。見ていると息を止めちゃう！",
      "at": "@auto-8:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-10",
      "speaker": "dango",
      "text": "おっ、動き出した！このまま無事に抜けられるといいな。",
      "at": "@auto-9:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-11",
      "speaker": "dango",
      "text": "ここまで来たら、もう引き返したくないね！",
      "at": "@auto-10:end+0.800",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-12",
      "speaker": "dango",
      "text": "ついに来たか…。最後まで目が離せないね、がんばって！",
      "at": "@auto-11:end+0.300",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-13",
      "speaker": "dango",
      "text": "おっと、危なかった！今の動き、見ててひやっとしたよ。",
      "at": "@auto-12:end+0.500",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-14",
      "speaker": "dango",
      "text": "やった、お見事！最後まで見守れてよかったね！",
      "at": "@auto-13:end+0.800",
      "pauseAfter": 0
    }
  ],
  "main": [
    {
      "at": 0,
      "until": 75,
      "video": "../work/dungeon-demo.mp4",
      "from": 0,
      "to": 75,
      "audio": false,
      "fit": "contain"
    }
  ],
  "panels": [
