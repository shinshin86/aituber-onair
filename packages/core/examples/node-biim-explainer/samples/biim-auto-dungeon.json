    {
      "id": "auto-8",
      "speaker": "dango",
      "text": "ここまで来たら応援するしかない！",
      "at": "@auto-7:end+5.600",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-9",
      "speaker": "dango",
      "text": "おっと、危なかった！",
      "at": "@auto-8:end+2.800",
      "pauseAfter": 0.3
    },
    {
      "id": "auto-10",
      "speaker": "dango",
      "text": "やった！お見事！",
      "at": "@auto-9:end+4.000",
      "pauseAfter": 0.3
    }
