{
  "name": "@aituber-onair/core-example-node-yukkuri-explainer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.dev.json",
    "test": "npm run typecheck && vitest run",
