{
  "name": "@aituber-onair/viewer-memory",
  "version": "0.0.1",
  "description": "Persistent per-viewer memory for AI VTuber live chat: name interpretation, consultation history, personal events, gift accumulation and session summaries.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "aituber",
    "vtuber",
    "live-chat",
    "viewer-memory",
    "persistent-memory",
    "tiktok",
    "twitch",
    "youtube"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.15.0",
    "typescript": "^5.0.0",
    "vitest": "^1.3.1"
  }
}
